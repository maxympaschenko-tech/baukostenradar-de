{
  "name": "baukostenradar-de",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname ${HOST:-127.0.0.1} --port ${PORT:-3000}",
