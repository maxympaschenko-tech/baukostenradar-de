{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/pricing": ["./lib/catalog-chimney.ts"],
      "@/lib/price-guide-links": ["./lib/price-guide-links-chimney.ts"],
      "@/lib/all-guides": ["./lib/all-guides-chimney.ts"],
      "@/lib/guide-groups": ["./lib/guide-groups-chimney.ts"],
      "@/lib/guide-silo": ["./lib/guide-silo-chimney.ts"],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
